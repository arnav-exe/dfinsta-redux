{
  "schema_version": 1,
  "variant": "430_minimal_tigon",
  "package": "com.instagram.android",
  "base_version_name": "430.0.0.53.80",
  "base_version_code": 383611248,
  "implementation_status": "Production v5 DEX graft built, signed, installed, settings-validated, and behavior-validated for Feed, Explore, Reels, and Stories",
  "privacy": {
    "amplitude_startup_telemetry": false,
    "acra_crash_reporting": false
  },
  "startup": {
    "component": "com.instagram.android/com.instagram.android.activity.MainTabActivity",
    "action": "android.intent.action.MAIN",
    "categories": ["android.intent.category.LAUNCHER"],
    "foreground_activity": "com.instagram.android/com.instagram.mainactivity.InstagramMainActivity",
    "logged_out_accepted_anchor_sets": [
      ["Join Instagram", "I already have a profile"],
      ["Password"]
    ],
    "required": ["process_alive", "no_android_runtime_fatal", "foreground_activity"]
  },
  "device_validation": {
    "feature_state": {
      "poll_attempts": 5,
      "poll_interval_seconds": 1,
      "settings_screen_selector": {"text": "Distraction-free settings - restart required"},
      "targets": [
        {
          "name": "home",
          "features": ["feed", "stories"],
          "selector": {"resource_id": "com.instagram.android:id/feed_tab", "content_desc": "Home"},
          "disabled_state_assertions": [
            {"name": "own_story_observation", "kind": "visible_text", "anchors": ["Your story"], "match": "all", "severity": "evidence"},
            {"name": "feed_item_text_absent", "kind": "absent_text", "anchors": ["Suggested for you", "Liked by"], "match": "all", "severity": "evidence"}
          ]
        },
        {
          "name": "explore",
          "features": ["explore"],
          "selector": {"resource_id": "com.instagram.android:id/search_tab", "content_desc": "Search and explore"},
          "disabled_state_assertions": [
            {"name": "search_shell_observation", "kind": "visible_text", "anchors": ["Search with Meta AI"], "match": "all", "severity": "evidence"},
            {"name": "discovery_text_absent", "kind": "absent_text", "anchors": ["Suggested for you"], "match": "all", "severity": "evidence"}
          ]
        },
        {
          "name": "reels",
          "features": ["reels"],
          "selector": {"resource_id": "com.instagram.android:id/clips_tab", "content_desc": "Reels"},
          "allow_screenshot_process_fallback": true,
          "disabled_state_assertions": [
            {"name": "cached_items_exhausted_observation", "kind": "absent_text", "anchors": ["Follow"], "match": "all", "severity": "evidence"}
          ]
        }
      ]
    }
  },
  "settings": {
    "surface": "framework AlertDialog",
    "activity": null,
    "title": "Distraction-free settings - restart required",
    "positive_button": "Close",
    "preference_file": "com.instagram",
    "entry": [
      "select resource-id com.instagram.android:id/profile_tab",
      "poll for content-desc Options with long-clickable=true",
      "long-click Options",
      "assert the framework multi-choice dialog title and five labels"
    ],
    "choices": [
      {"order": 1, "label": "Disable feed", "key": "disable_feed", "default_checked": true},
      {"order": 2, "label": "Disable Explore", "key": "disable_explore", "default_checked": true},
      {"order": 3, "label": "Disable Reels", "key": "disable_reels", "default_checked": true},
      {"order": 4, "label": "Disable Stories", "key": "disable_stories", "default_checked": true},
      {"order": 5, "label": "Disable profile ads", "key": "disable_adds", "default_checked": true}
    ],
    "process_restart_required_after_change": true,
    "cached_content_warning": "Previously cached content may remain visible temporarily after restart"
  },
  "features": {
    "feed": {"implementation": "Tigon URI blocking", "verified_contrast": true},
    "explore": {"implementation": "Tigon URI blocking", "verified_contrast": true},
    "reels": {"implementation": "Tigon URI blocking plus direct central endpoint replacement", "verified_contrast": true, "warning": "cached Reels can survive process restart; disabled validation requires cache exhaustion"},
    "stories": {"implementation": "Tigon URI blocking", "verified_contrast": true},
    "shopping": {"implementation": "retired from the 430 distraction contract because the standalone Shopping tab is gone", "verified_contrast": false},
    "profile_ads": {"implementation": "exact Tigon URI blocking", "key": "disable_adds", "default_checked": true, "visible_switch": true, "verified_contrast": false, "warning": "runtime contrast depends on account and ad-inventory eligibility"}
  },
  "pending": [
    "Profile-ad eligible-account runtime contrast",
    "Other-user profile long-click exclusion",
    "Durable agentic orchestration"
  ]
}
